{
	"name": "tscode-remote-ssh",
	"displayName": "TestAgent Remote",
	"description": "连接至 TestAgent Cloud 服务",
	"version": "1.0.0",
	"publisher": "test-tech",
	"engines": {
		"vscode": "^1.70.2"
	},
	"main": "./lib/extension.js",
	"browser": "./lib/extension.js",
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "webpack --mode production",
		"bundle:dev": "webpack --mode development",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf --glob lib out \"*.vsix\" .test",
		"compile:src": "tsc -b",
		"compile:test": "tsc -p test",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf --glob \"*.vsix\" && vsce package --allow-missing-repository --skip-license --readme-path \"\"",
		"postinstall": "npm run update:dts",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:images": "bash ./dockerfiles/build.sh",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"update:dts": "npx vscode-dts dev && npx vscode-dts main",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p . --onSuccess 'npm run bundle:dev'",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@zokugun/is-it-type": "0.8.1",
		"glob": "13.0.6",
		"simple-socks": "3.6.0",
		"socks": "2.8.9",
		"ssh-config": "5.2.0",
		"ssh2": "git+https://github.com/JustWorkingAndWorking/ssh2#master"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "20.19.43",
		"@types/ssh2": "0.5.52",
		"@types/ssh2-streams": "0.1.13",
		"@types/webpack": "5.28.5",
		"@typescript-eslint/eslint-plugin": "8.65.0",
		"@typescript-eslint/parser": "8.65.0",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"@vscode/vsce": "3.9.2",
		"@zokugun/fs-extra-plus": "0.5.0",
		"@zokugun/xtry": "0.11.6",
		"eslint": "10.8.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"memfs": "4.64.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.16.0",
		"ts-loader": "9.6.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.65.0",
		"universalify": "2.0.1",
		"vitest": "4.1.10",
		"webpack": "5.109.0",
		"webpack-cli": "7.2.1",
		"yaml": "2.9.0"
	},
	"activationEvents": [
		"onCommand:openremotessh.createContainer",
		"onCommand:openremotessh.openEmptyWindow",
		"onCommand:openremotessh.openEmptyWindowInCurrentWindow",
		"onCommand:openremotessh.openConfigFile",
		"onCommand:openremotessh.refreshContainers",
		"onCommand:openremotessh.showLog",
		"onResolveRemoteAuthority:ssh-remote",
		"onView:sshHosts"
	],
	"contributes": {
		"configuration": {
			"title": "TestAgent Remote",
			"properties": {
				"testagnet.remote.backendApiUrl": {
					"type": "string",
					"description": "后端 TestAgent Cloud 管理服务的 API 地址。",
					"default": "",
					"scope": "application"
				},
				"testagnet.remote.configFile": {
					"type": "string",
					"description": "指定插件使用的配置文件的绝对路径。",
					"default": "~/.local/share/testagent/config",
					"scope": "application"
				},
				"testagnet.remote.connectTimeout": {
					"type": "number",
					"description": "指定用于连接 TestAgent Cloud 服务的超时时间 (秒)。",
					"default": 60,
					"scope": "application",
					"minimum": 1
				},
				"testagnet.remote.debug": {
					"type": "boolean",
					"description": "启用调试模式",
					"default": false,
					"scope": "application"
				},
				"testagnet.remote.disableClientValidation": {
					"type": "boolean",
					"description": "是否禁用 TestAgent 本地与云端版本校验功能。",
					"default": true,
					"scope": "application"
				},
				"testagnet.remote.defaultExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "应自动安装到所有 TestAgent Cloud 服务上的扩展列表。",
					"scope": "application"
				},
				"testagnet.remote.defaultPath": {
					"type": "string",
					"description": "连接至 TestAgent Cloud 服务后默认进入的绝对路径。",
					"default": "/app",
					"scope": "application"
				},
				"testagnet.remote.enableAgentForwarding": {
					"type": "boolean",
					"markdownDescription": "启用远程环境修复，使得配置选项 `ForwardAgent` 在 TestAgent Cloud 服务中按预期生效。",
					"scope": "application",
					"default": true
				},
				"testagnet.remote.enableDynamicForwarding": {
					"type": "boolean",
					"description": "是否使用动态转发，以便通过现有连接建立新的端口隧道。",
					"scope": "application",
					"default": true
				},
				"testagnet.remote.historyLimit": {
					"type": "integer",
					"description": "指定过期的 TestAgent Cloud 服务的保留数。",
					"default": 5,
					"minimum": 0,
					"scope": "application"
				},
				"testagnet.remote.remotePlatform": {
					"type": "object",
					"description": "将远程主机名映射到对应平台。有效值：linux、macos、windows。",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string",
						"enum": [
							"linux",
							"macos",
							"windows"
						]
					}
				},
				"testagnet.remote.remoteServerListenOnSocket": {
					"type": "boolean",
					"description": "为 true 时，TestAgent Cloud 服务将监听套接字路径，而不是监听端口。仅适用于 Linux 和 macOS 远程主机。要求 TestAgent Cloud 服务上启用了 `AllowStreamLocalForwarding`。",
					"default": false
				},
				"testagnet.remote.skipKnownHostsCheck": {
					"type": "boolean",
					"description": "是否在配置中为新增的 TestAgent Cloud 服务跳过主机指纹验证。",
					"default": true,
					"scope": "application"
				},
				"testagnet.remote.statusSyncInterval": {
					"type": "number",
					"description": "指定 TestAgent Cloud 服务的状态同步时间 (秒)。",
					"default": 5,
					"minimum": 1,
					"scope": "application"
				},
				"testagnet.remote.userName": {
					"type": "string",
					"description": "TestAgent Cloud 服务登录用户名。",
					"default": "root",
					"scope": "application"
				}
			}
		},
		"views": {
			"remote": [
				{
					"id": "sshHosts",
					"name": "TestAgent Cloud",
					"group": "targets@1",
					"type": "webview",
					"remoteName": "ssh-remote"
				}
			]
		},
		"commands": [
			{
				"command": "openremotessh.createContainer",
				"title": "创建新的 TestAgent Cloud 服务...",
				"category": "TestAgent Cloud"
			},
			{
				"command": "openremotessh.openEmptyWindow",
				"title": "连接到已有的 TestAgent Cloud 服务...",
				"category": "TestAgent Cloud"
			},
			{
				"command": "openremotessh.openEmptyWindowInCurrentWindow",
				"title": "将当前窗口连接到已有的 TestAgent Cloud 服务...",
				"category": "TestAgent Cloud"
			},
			{
				"command": "openremotessh.openConfigFile",
				"title": "打开配置文件",
				"category": "TestAgent Cloud"
			},
			{
				"command": "openremotessh.refreshContainers",
				"title": "刷新 TestAgent Cloud 服务列表",
				"category": "TestAgent Cloud"
			},
			{
				"command": "openremotessh.showLog",
				"title": "显示日志",
				"category": "TestAgent Cloud"
			}
		],
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "ssh-remote+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "SSH"
				}
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "openremotessh.openEmptyWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@1"
				},
				{
					"command": "openremotessh.openEmptyWindowInCurrentWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@2"
				},
				{
					"command": "openremotessh.openConfigFile",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@3"
				},
				{
					"command": "openremotessh.createContainer",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@4"
				},
				{
					"command": "openremotessh.openEmptyWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@5"
				},
				{
					"command": "openremotessh.openEmptyWindowInCurrentWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@6"
				}
			],
			"commandPalette": [
				{
					"command": "openremotessh.createContainer",
					"when": "remoteConnectionState == disconnected"
				}
			]
		}
	},
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"overrides": {
		"release-it": {
			"undici": "7.29.0"
		}
	},
	"allowScripts": {
		"fsevents": true
	},
	"api": "none",
	"enabledApiProposals": [
		"resolvers",
		"contribViewsRemote"
	],
	"extensionKind": [
		"ui"
	]
}
