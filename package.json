{
	"name": "tscode-remote-ssh",
	"displayName": "TestAgent Remote",
	"description": "连接至 TestAgent 远程服务器",
	"version": "1.0.0",
	"publisher": "test-tech",
	"engines": {
		"vscode": "^1.70.2"
	},
	"main": "./lib/extension.js",
	"browser": "./lib/extension.js",
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "webpack --mode production",
		"bundle:dev": "webpack --mode development",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf --glob lib out \"*.vsix\" .test",
		"compile:src": "tsc -b",
		"compile:test": "tsc -p test",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf --glob \"*.vsix\" && vsce package --allow-missing-repository --skip-license --readme-path \"\"",
		"postinstall": "npm run update:dts",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:images": "./dockerfiles/build.sh",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"update:dts": "npx vscode-dts dev && npx vscode-dts main",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p . --onSuccess 'npm run bundle:dev'",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@zokugun/is-it-type": "0.8.1",
		"glob": "13.0.6",
		"simple-socks": "3.6.0",
		"socks": "2.8.9",
		"ssh-config": "5.2.0",
		"ssh2": "git+https://github.com/JustWorkingAndWorking/ssh2#master"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "20.19.43",
		"@types/ssh2": "0.5.52",
		"@types/ssh2-streams": "0.1.13",
		"@types/webpack": "5.28.5",
		"@typescript-eslint/eslint-plugin": "8.65.0",
		"@typescript-eslint/parser": "8.65.0",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"@vscode/vsce": "3.9.2",
		"@zokugun/fs-extra-plus": "0.5.0",
		"@zokugun/xtry": "0.11.6",
		"eslint": "10.8.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"memfs": "4.64.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.16.0",
		"ts-loader": "9.6.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.65.0",
		"universalify": "2.0.1",
		"vitest": "4.1.10",
		"webpack": "5.109.0",
		"webpack-cli": "7.2.1",
		"yaml": "2.9.0"
	},
	"activationEvents": [
		"onCommand:openremotessh.openEmptyWindow",
		"onCommand:openremotessh.openEmptyWindowInCurrentWindow",
		"onCommand:openremotessh.openConfigFile",
		"onCommand:openremotessh.showLog",
		"onResolveRemoteAuthority:ssh-remote",
		"onView:sshHosts"
	],
	"contributes": {
		"configuration": {
			"title": "TestAgent Remote",
			"properties": {
				"remote.SSH.configFile": {
					"type": "string",
					"description": "自定义 SSH 配置文件的绝对路径。",
					"default": "",
					"scope": "application"
				},
				"remote.SSH.connectTimeout": {
					"type": "number",
					"description": "指定用于连接远程主机的 SSH 命令超时时间 (秒)。",
					"default": 60,
					"scope": "application",
					"minimum": 1
				},
				"remote.SSH.defaultExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "应自动安装到所有 SSH 主机上的扩展列表。",
					"scope": "application"
				},
				"remote.SSH.enableDynamicForwarding": {
					"type": "boolean",
					"description": "是否使用 SSH 动态转发，以便通过现有 SSH 连接建立新的端口隧道。",
					"scope": "application",
					"default": true
				},
				"remote.SSH.enableAgentForwarding": {
					"type": "boolean",
					"markdownDescription": "启用远程环境修复，使 SSH 配置选项 `ForwardAgent` 在 TestAgent 工作台的远程扩展主机中按预期生效。",
					"scope": "application",
					"default": true
				},
				"remote.SSH.remotePlatform": {
					"type": "object",
					"description": "将远程主机名映射到对应平台。有效值：linux、macos、windows。",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string",
						"enum": [
							"linux",
							"macos",
							"windows"
						]
					}
				},
				"remote.SSH.remoteServerListenOnSocket": {
					"type": "boolean",
					"description": "为 true 时，远程 TestAgent 服务器将监听套接字路径，而不是打开端口。仅适用于 Linux 和 macOS 远程主机。要求 SSH 服务器启用 `AllowStreamLocalForwarding`。",
					"default": false
				},
				"remote.SSH.serverBinaryName": {
					"type": "string",
					"description": "预装远程服务器二进制文件的名称。",
					"scope": "application",
					"default": ""
				}
			}
		},
		"views": {
			"remote": [
				{
					"id": "sshHosts",
					"name": "SSH 主机",
					"group": "targets@1",
					"remoteName": "ssh-remote"
				}
			]
		},
		"commands": [
			{
				"command": "openremotessh.openEmptyWindow",
				"title": "连接到主机...",
				"category": "远程 SSH"
			},
			{
				"command": "openremotessh.openEmptyWindowInCurrentWindow",
				"title": "将当前窗口连接到主机...",
				"category": "远程 SSH"
			},
			{
				"command": "openremotessh.openConfigFile",
				"title": "打开 SSH 配置文件...",
				"category": "远程 SSH"
			},
			{
				"command": "openremotessh.showLog",
				"title": "显示日志",
				"category": "远程 SSH"
			},
			{
				"command": "openremotessh.explorer.emptyWindowInNewWindow",
				"title": "在新窗口中连接到主机",
				"icon": "$(empty-window)"
			},
			{
				"command": "openremotessh.explorer.emptyWindowInCurrentWindow",
				"title": "在当前窗口中连接到主机"
			},
			{
				"command": "openremotessh.explorer.reopenFolderInCurrentWindow",
				"title": "在当前窗口中打开 SSH 主机上的文件夹"
			},
			{
				"command": "openremotessh.explorer.reopenFolderInNewWindow",
				"title": "在新窗口中打开 SSH 主机上的文件夹",
				"icon": "$(folder-opened)"
			},
			{
				"command": "openremotessh.explorer.deleteFolderHistoryItem",
				"title": "从最近列表中移除",
				"icon": "$(x)"
			},
			{
				"command": "openremotessh.explorer.refresh",
				"title": "刷新",
				"icon": "$(refresh)"
			},
			{
				"command": "openremotessh.explorer.configure",
				"title": "配置",
				"icon": "$(gear)"
			},
			{
				"command": "openremotessh.explorer.add",
				"title": "添加新主机",
				"icon": "$(plus)"
			}
		],
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "ssh-remote+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "SSH"
				}
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "openremotessh.openEmptyWindow",
					"when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@1"
				},
				{
					"command": "openremotessh.openEmptyWindowInCurrentWindow",
					"when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@2"
				},
				{
					"command": "openremotessh.openConfigFile",
					"when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@3"
				},
				{
					"command": "openremotessh.showLog",
					"when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@4"
				},
				{
					"command": "openremotessh.openEmptyWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@1"
				},
				{
					"command": "openremotessh.openEmptyWindowInCurrentWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@2"
				},
				{
					"command": "openremotessh.openConfigFile",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@3"
				},
				{
					"command": "openremotessh.openEmptyWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@5"
				},
				{
					"command": "openremotessh.openEmptyWindowInCurrentWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@6"
				},
				{
					"command": "openremotessh.openConfigFile",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@7"
				}
			],
			"commandPalette": [
				{
					"command": "openremotessh.explorer.refresh",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.configure",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.add",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.emptyWindowInNewWindow",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.emptyWindowInCurrentWindow",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.reopenFolderInCurrentWindow",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.reopenFolderInNewWindow",
					"when": "false"
				},
				{
					"command": "openremotessh.explorer.deleteFolderHistoryItem",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "openremotessh.explorer.add",
					"when": "view == sshHosts",
					"group": "navigation"
				},
				{
					"command": "openremotessh.explorer.configure",
					"when": "view == sshHosts",
					"group": "navigation"
				},
				{
					"command": "openremotessh.explorer.refresh",
					"when": "view == sshHosts",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "openremotessh.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^openremotessh.explorer.host$/",
					"group": "inline@1"
				},
				{
					"command": "openremotessh.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^openremotessh.explorer.host$/",
					"group": "navigation@2"
				},
				{
					"command": "openremotessh.explorer.emptyWindowInCurrentWindow",
					"when": "viewItem =~ /^openremotessh.explorer.host$/",
					"group": "navigation@1"
				},
				{
					"command": "openremotessh.explorer.reopenFolderInNewWindow",
					"when": "viewItem == openremotessh.explorer.folder",
					"group": "inline@1"
				},
				{
					"command": "openremotessh.explorer.reopenFolderInNewWindow",
					"when": "viewItem == openremotessh.explorer.folder",
					"group": "navigation@2"
				},
				{
					"command": "openremotessh.explorer.reopenFolderInCurrentWindow",
					"when": "viewItem == openremotessh.explorer.folder",
					"group": "navigation@1"
				},
				{
					"command": "openremotessh.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^openremotessh.explorer.folder/",
					"group": "navigation@3"
				},
				{
					"command": "openremotessh.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^openremotessh.explorer.folder/",
					"group": "inline@2"
				}
			]
		}
	},
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"overrides": {
		"release-it": {
			"undici": "7.29.0"
		}
	},
	"allowScripts": {
		"fsevents": true
	},
	"api": "none",
	"enabledApiProposals": [
		"resolvers",
		"contribViewsRemote"
	],
	"extensionKind": [
		"ui"
	]
}
